 ],
 "reasons": {
  "cb_amount_low": "成交额折算的均价远低于当天最低价（原因未查明）",
  "close_20200225": "2020-02-26 一批基金（多为深市分级基金、LOF，也有几只 ETF）：交易所前收盘与源给的 2020-02-25 收盘不同，复权因子没动，次日前收盘又与 2020-02-26 收盘一致；疑为源的 2020-02-25 收盘有误，只影响一天的估值（原因未查明）",
  "code_not_in_table": "日线里出现基金表没有的代码（161022A.SZ 是分级基金份额的特殊代码，158008.OF 是场外代码），面板不收",
  "factor_vs_gap": "复权因子的变化与交易所前收盘缺口不一致（分级基金折算、长期停牌后复牌、LOF 分红等），面板按复权因子记事件，交易所参考价对不上（原因未查明）",
  "fund_amount_x10": "成交额约为成交量×价格的十倍：源单行成交额错误",
  "graded_20201030": "2020-10-30 几只分级基金及其母基金：前收盘与上一有行情日收盘不同，复权因子没动（分级基金当年按资管新规清理，原因未查明）",
  "no_trade_days": "两个有行情日之间隔着源里没有日线（无成交或缺行）或只有沿用价的交易日，交易所前收盘与上一有行情日收盘不同；复权因子没动、没有分红记录，不是公司行为，面板不记事件（原因未查明）",
  "one_price_bar": "日线开高低收为同一个价，成交额折算的均价却不在这个价上：价格字段是沿用值，成交量额是真实成交（源为何这样给未查明）；面板把这一天算作无行情、不能成交",
  "reits_distribution": "REITs 收益分配：交易所不调整前收盘，复权因子按分配调整；面板按复权因子记现金分配",
  "source_missing_factor": "源在这几个有行情的日子没有这只基金的复权因子（其余日子都有），面板这几天按交易所前收盘缺口裁决"
 },
