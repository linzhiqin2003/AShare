{
 "source": "Tushare Pro（fund_basic / fund_daily / fund_adj / fund_div / cb_basic / cb_daily / cb_call / cb_price_chg），数据 2015-01-05 至 2026-11-12",
 "note": "每条：check 为 verify-funds 的检查项，其余字段为匹配键，reason 指向 reasons。由「空清单校验」列出全部不符后逐条归类；新数据里出现清单之外的不符，校验即失败。只写匹配键与原因，不写由价格、成交量、成交额算出的数值。",
 "cause_unknown": [
  "cb_amount_low",
  "gap_20200226",
  "gap_other",
  "one_price_bar",
  "seven_digit_code"
 ],
 "reasons": {
  "one_price_bar": "日线开高低收为同一个价，成交额折算的均价却不在这个价上：源这天的价格字段疑似沿用参考价，成交量额是真实成交；多出现在次日交易所前收盘与这天收盘不同的日子（原因未查明）",
  "after_one_price_bar": "前一交易日是「开高低收同一个价」的日线，它的收盘价不是真实收盘；交易所前收盘用的是真实收盘，所以这一天的前收盘缺口与复权因子对不上（不是拆分、折算）",
  "gap_20200226": "2020-02-26 深市一批分级基金：前收盘与上一日收盘不同，复权因子未变，上一日日线正常（原因未查明；分级基金 2020 年底已全部清理）",
  "fund_amount_x10": "成交额约为成交量×价格的十倍：源单行成交额错误",
  "cb_amount_low": "成交额折算的均价远低于当天最低价（原因未查明）",
  "code_not_in_table": "日线里出现基金表没有的代码（161022A.SZ 是分级基金份额的特殊代码，158008.OF 是场外代码），面板不收",
  "reits_distribution": "REITs 收益分配：交易所不调整前收盘，复权因子按分配调整；面板只记现金分配、不当拆分",
  "seven_digit_code": "七位代码（1612301.SZ、1648141.SZ）是源给复用代码的旧基金另编的代码，分级份额定期折算日前收盘调整、复权因子未变（原因未查明）",
  "gap_other": "前收盘缺口与复权因子变化对不上，上一日日线正常（LOF 转型前后等，原因未查明）"
 },
