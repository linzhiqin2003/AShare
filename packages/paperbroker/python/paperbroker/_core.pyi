import numpy as np
from numpy.typing import NDArray

class BrokerCore:
    def __init__(self, config: str) -> None: ...
    def apply(self, event: str) -> None: ...
    def feed(
        self, quotes: NDArray[np.int64], received_at: int | None = None
    ) -> None: ...
    def dump(self) -> str: ...
    def account(self) -> str: ...
    def events(self) -> str: ...
    @staticmethod
    def restore(state: str) -> BrokerCore: ...
    @staticmethod
    def validate_quotes(quotes: NDArray[np.int64], symbols: int) -> None: ...
